# ─────────────────────────────────────────────
# Fraud AI Investigator — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# NEVER commit your real .env file to GitHub.
#
# Free key sources (no credit card needed):
#   Gemini → https://aistudio.google.com/apikey
#   Groq   → https://console.groq.com/keys
# ─────────────────────────────────────────────

# ── LLM API Keys ──────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# ── Primary model config ───────────────────────
# Gemini 2.5 Flash — free tier, fast, capable
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Groq fallback — Llama 3 70B, also free
GROQ_MODEL=llama3-70b-8192

# ── Application config ─────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ── Fraud thresholds (AED) ─────────────────────
# UAE Central Bank reporting threshold
HIGH_VALUE_THRESHOLD_AED=40000

# Auto-escalate above this amount
CRITICAL_AMOUNT_THRESHOLD_AED=200000

# ── Risk scoring bands ─────────────────────────
# Score 0–100: LOW < 30, MEDIUM 30–70, HIGH 70–90, CRITICAL 90+
RISK_BAND_LOW=30
RISK_BAND_MEDIUM=70
RISK_BAND_HIGH=90
